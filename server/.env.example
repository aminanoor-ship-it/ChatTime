NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=CHANGE_TO_YOUR_MYSQL_PASSWORD
DB_NAME=realtime_chat

# At least 32 random characters. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_TO_A_LONG_RANDOM_SECRET_VALUE
COOKIE_NAME=chat_session

# Optional: where uploaded files are stored (defaults to the project's uploads/ folder).
# UPLOAD_DIR=

# Used once by `npm run create-admin`; remove ADMIN_PASSWORD afterwards.
ADMIN_USERNAME=siteadmin
ADMIN_EMAIL=admin@example.com
ADMIN_DISPLAY_NAME=Site Administrator
ADMIN_PASSWORD=Choose_A_Strong_Unique_Password_123!
